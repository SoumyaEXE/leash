{
  "name": "@leash/mcp",
  "version": "0.1.0",
  "description": "MCP server: give any MCP agent (Claude Code, Claude Desktop, ...) a leashed Solana wallet",
  "license": "MIT",
  "type": "module",
  "bin": { "leash-mcp": "./dist/index.js" },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform node --target node22 --out-dir dist --clean --noExternal @leash/sdk",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@leash/sdk": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "@x402/core": "^2.30.0",
    "@solana/web3.js": "^1.99.0",
    "dotenv": "^17.2.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
