# Copy to .env and fill in. Never commit .env.
# Empty values fall back to the default named in the comment.

# ── Solana (devnet only) ─────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com     # better: https://devnet.helius-rpc.com/?api-key=<KEY> (free at dashboard.helius.dev)
SOLANA_WS_URL=wss://api.devnet.solana.com       # with Helius: wss://devnet.helius-rpc.com/?api-key=<KEY>
LEASH_PROGRAM_ID=                      # written by scripts after `anchor deploy`
OWNER_KEYPAIR_PATH=keys/owner.json     # the human owner (also program upgrade authority)
AGENT_KEYPAIR_PATH=keys/agent.json     # the leashed agent's signing key (holds only fee SOL)
VICTIM_KEYPAIR_PATH=keys/victim.json   # the unprotected agent's wallet (holds dUSDC directly)
ATTACKER_KEYPAIR_PATH=keys/attacker.json # V12 replay only (`pnpm --filter agent v12`): fee payer of the hostile x402 server
ATTACKER_PUBKEY=                       # where injected instructions try to send funds
MERCHANT_PUBKEY=                       # payTo for the Market Data API (allowlisted payee)
RESEARCH_PUBKEY=                       # payTo for the Research API (allowlisted payee; written by scripts)
DUSDC_MINT=                            # our own 6-decimal devnet test mint (scripts/setup-devnet.ts)
LEASH_VAULT_ID_OFFSET=                 # default 0; added to the demo vault ids 1/2/3. `pnpm setup:devnet` moves it past old-layout vaults (steps of 10) and saves it here
LEASH_VAULT=                           # demo vault PDA (vault_id 1 + offset; enforce_tripwire off)
ARENA_VAULT=                           # Red Team Arena bounty vault PDA (vault_id 2 + offset; guarded, never freezes)
TRIPWIRE_VAULT=                        # auto-freeze demo vault PDA (vault_id 3 + offset; freezes after 3 strikes)

# ── AI: You.com (free credits: Answer + Search APIs) ────────────────
YDC_API_KEY=
LLM_PROVIDER=youcom-answer             # youcom-answer (free) | youcom-router (needs purchased credits)
YDC_ROUTER_MODEL=                      # model id from GET https://api.you.com/v1/models (router only)

# ── Services ─────────────────────────────────────────────────────────
AGENT_SERVER_PORT=4020
AGENT_SERVER_URL=http://localhost:4020
X402_SERVER_PORT=4021
X402_SERVER_URL=http://localhost:4021
ARENA_ENABLED=true

# ── Agent server (apps/agent) ────────────────────────────────────────
HOST=                                  # default: loopback only (127.0.0.1 and ::1). Set e.g. 0.0.0.0 only on a hosting box
AGENT_TOKEN=                           # default: no auth (local demo). When hosted, POST /run, /run-split, /reset need "Authorization: Bearer <AGENT_TOKEN>"; /api/agent adds it server-side
LAB_DOCS_BASE_URL=                     # A1 lab: where /lab/market-data/* is served (default NEXT_PUBLIC_SITE_URL, then http://localhost:3000)

# ── x402 servers (apps/x402-servers) ─────────────────────────────────
X402_TRUST_PROXY=                      # default unset (req.ip = socket address). Behind a hosting proxy: number of proxy hops, so per-IP limits see the client
X402_MAX_NONCES=                       # default 10000: issued payment terms kept in memory
X402_ISSUE_PER_MINUTE=                 # default 120: 402 payment terms issued per client IP per minute
X402_REQUIRE_PAYER_AUTH=               # default on. 0 turns off the payer signature check (leash-x402-payer:v1); dev only

# ── Web API limits (apps/web/app/api; in memory per server process) ──
TRUSTED_IP_HEADER=                     # platform client-IP header (cf-connecting-ip, fly-client-ip, x-real-ip, ...). Default: x-vercel-forwarded-for on Vercel, otherwise no header is trusted and all visitors share one bucket
RPC_RATE_LIMIT_PER_MIN=                # default 600: /api/rpc calls per minute per IP (getProgramAccounts counts 5)
RPC_DAILY_ALARM=                       # default 50000: log a quota alarm each time this many upstream RPC calls are made in a UTC day
RPC_DAILY_MAX=                         # default no limit: hard stop for upstream RPC calls per UTC day
ARENA_MESSAGES_PER_10MIN=              # default 10: Arena messages per 10 minutes, per IP and per payout address
ARENA_YOU_DAILY_BUDGET=                # default 600: You.com calls per UTC day for Warden (uses YDC_API_KEY)
AGENT_PROXY_RUNS_PER_10MIN=            # default 20: /api/agent demo runs and resets per 10 minutes per IP

# ── Web (exposed to the browser: never put secrets here) ─────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SOLANA_RPC_URL=proxy                # browser → /api/rpc → SOLANA_RPC_URL (keeps the Helius key server-side)
NEXT_PUBLIC_SOLANA_WS_URL=wss://api.devnet.solana.com
NEXT_PUBLIC_LEASH_PROGRAM_ID=
NEXT_PUBLIC_LEASH_VAULT=
NEXT_PUBLIC_ARENA_VAULT=
NEXT_PUBLIC_DUSDC_MINT=
NEXT_PUBLIC_AGENT_SERVER_URL=http://localhost:4020   # hosted: /api/agent (same-origin proxy that adds AGENT_TOKEN)
NEXT_PUBLIC_EXPLORER=https://explorer.solana.com
